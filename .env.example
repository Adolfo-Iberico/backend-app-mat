# Plantilla de produccion. Sustituye todos los dominios y credenciales antes
# de desplegar; nunca uses los valores de ejemplo como secretos reales.
# Genera APP_KEY con: php artisan key:generate
APP_NAME=Aulamate
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=replace_with_production_database_host
DB_PORT=3306
DB_DATABASE=replace_with_production_database
DB_USERNAME=replace_with_production_user
DB_PASSWORD=replace_with_production_database_password
DB_DUMP_BINARY_PATH=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database
CACHE_PREFIX=aulamate_cache_

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=replace_with_smtp_host
MAIL_PORT=2525
MAIL_USERNAME=replace_with_smtp_user
MAIL_PASSWORD=replace_with_smtp_password
MAIL_FROM_ADDRESS="hola@aulamate.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=app.example.com
SANCTUM_GUARD=web
SANCTUM_EXPIRATION=1440
CORS_ALLOWED_ORIGINS=https://app.example.com
API_RATE_LIMIT_MAX=60
API_RATE_LIMIT_DECAY_MINUTES=1
GLOBAL_RATE_LIMIT_MAX=120
GLOBAL_RATE_LIMIT_DECAY_MINUTES=1
DEFAULT_STUDENT_PASSWORD=replace-with-a-temporary-password

# Integracion opcional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/auth/google/callback

# Integracion opcional: funciones de IA
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile

# Integracion opcional: notificaciones push
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# Credenciales opcionales para Web Push; genera claves VAPID para habilitarlo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT_EMAIL=admin@aulamate.com

VITE_APP_NAME="${APP_NAME}"

SENTRY_DSN=
